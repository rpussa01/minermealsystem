generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Miner {
  id         String   @id @default(cuid())
  name       String
  mobile     String   @unique
  company    String?
  roomNumber String?
  active     Boolean  @default(true)

  orders     MealOrder[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MealOrder {
  id           String   @id @default(cuid())
  orderDate    DateTime

  breakfast    String
  lunchOption1 String
  lunchOption2 String
  fruit        String
  drink        String
  sweet        String
  notes        String?

  minerId      String
  miner        Miner    @relation(fields: [minerId], references: [id])

  submittedAt  DateTime @default(now())

  @@unique([minerId, orderDate])
}
